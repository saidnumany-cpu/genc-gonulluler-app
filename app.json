{
  "expo": {
    "name": "Genç Gönüllüler",
    "slug": "genc-gonulluler",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gencgonulluler",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.gencgonulluler.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gencgonulluler.app",
      "adaptiveIcon": {
        "backgroundColor": "#D7192B",
        "foregroundImage": "./assets/images/icon.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Genç Gönüllüler",
      "shortName": "Gönüllüler",
      "themeColor": "#D7192B",
      "backgroundColor": "#F7F6F5"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
